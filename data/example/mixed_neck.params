# Example: a periodic membrane patch with a free-rimmed neck.
#
# The bottleneck case, and the one no global boundary mode can express: the
# membrane wraps in both directions, so it is a patch of an unbounded sheet,
# and it is *open* at a neck in the middle, whose rim is a free boundary. Two
# different boundary conditions on one mesh, which is what per-vertex types
# are for.
#
# The mesh is not generated by the flat-sheet generator -- it has a hole, so
# no grid describes it -- and is read from files instead:
#
#   data/example/mixed_neck_vertices.csv    x, y, z, type, mirror
#   data/example/mixed_neck_faces.csv       v0, v1, v2, copy
#
# 711 vertices: 382 free (16 of them on the rim of the neck), 329 periodic
# images. The rim vertices are ordinary degrees of freedom; the faces that
# touch them have no complete one-ring and so carry no limit surface, which is
# what an open edge means here.
#
# Rebuild it, or build your own, with:
#
#   python3 data/example/make_mixed_mesh.py --out data/example/mixed_neck \
#       --side 120 --pore-radius 12 --neck-height 8 --neck-width 25
#
# The paths below are relative to the working directory, so run this one from
# the top of the source tree:
#
#   cp data/example/mixed_neck.params input.params
#   ./build/bin/membrane_dynamics
#
# The starting geometry is a collar rising to the rim; it is a starting
# configuration, not an equilibrium one, and the run relaxes it. What the
# example fixes is the boundary condition, not the shape.
#
# See docs/mixed_boundary_conditions.md.

############################################
## Boundary Conditions
############################################

boundaryType = Mixed             # the types in the vertex file decide the boundary
surfaceSolver = iterative        # required by the dynamics under Mixed

############################################
## The mesh, from files rather than generated
############################################

meshVerticesFile = data/example/mixed_neck_vertices.csv
meshFacesFile = data/example/mixed_neck_faces.csv

# lFace is still read: it sets the target triangle area the regularization and
# the mesh-quality terms measure against. Match it to the mesh you loaded.
lFace = 5.0

############################################
## Physical Properties
############################################

c0Insertion = 0.0
c0Membrane = 0.0
kcMembraneBending = 83.4
usMembraneStretching = 250.0
uvVolumeConstraint = 0.0         # images tile an open sheet: no enclosed volume
isGlobalConstraint = true
forceBackend = cpu
KBT = 4.17

############################################
## Dynamics
############################################

maxIterations = 1000
timeStep = 0.001
diffConst = 1.0
meshpointOutput = true
meshpointOutputInterval = 10
xyzOutput = true
fdtConsistentSurfaceUpdate = true
inPlaneDynamicsEnabled = false

############################################
## Bounding the open rim
############################################

# The rim of the neck is a free boundary, and a free boundary under the
# dynamics needs this. The reference-length regularization is not part of the
# Brownian drive -- the step is driven by the bending and area forces alone,
# and picks up the mesh-quality force only when edgeSpringEnabled is true --
# and the faces touching the rim carry no limit surface, so without a tether
# nothing bounds the distance between one rim vertex and the next: measured on
# this mesh without it, edges reached 17 nm on a 5 nm mesh in 1000 steps.
#
# The flat tether is exactly zero inside [min, max] * lFace, so it leaves the
# membrane the run is sampling alone and only forbids the runaway.
edgeSpringEnabled = true
edgeTetherShape = flat
edgeSpringConstant = 83.4        # pN/nm
edgeTetherMinRatio = 0.95        # wall below 0.95 * lFace
edgeTetherMaxRatio = 1.75        # wall above 1.75 * lFace

############################################
## Off for this example
############################################

isInsertionIncluded = false
isEnergyHarmonicBondIncluded = false
thermalFluctuationEnabled = false
edgeFlipEnabled = false

############################################
## Developer options
############################################

VERBOSE_MODE = false
