# input parameters for continuum membrane model @author YY Oct 19, 2021
# please do not change the variable name strings
# @TODO separate out BCs; physical properties (bending modulus); geometry (sphere, cylindrical, planar)
# for advanced usesrs: more technical values (mesh side); 
# algorithmic parameters; 

############################################
## Dynamics Model Parameters
############################################

maxIterations = 500000         # total number of iterations
meshpointOutput = true			# outputs meshpoint.csv 
xyzOutput = true				# outputs trajectory.xyz
deltaEnergyConverge = 1e-5      # converging criteria for total energy
deltaForceScaleConverge = 1e-4  # converging criteria for max force scale


############################################
## Boundary Conditions
############################################

boundaryType = Periodic          # boundary condition type : Fixed, Free or Periodic

############################################
## Geometric Parameters
############################################

lFace = 5.0 				# target side length of triangular mesh (nm)

# Sphere model not implemented
# isSphere = false					# sphere mode
# rSphere = 20.0					# target radius of sphere (nm)

# Flat model
isFlat = true                                  # flat mode -> surrent only flat mode is supported
sideX = 300.0                                  # target X side length of flat membrane (nm)
sideY = 300.0                                  # target Y side length of flat membrane (nm)

############################################
## Physical Properties
############################################

c0Insertion = 0.0				# spontaneous curvature of insertion
c0Membrane = 0.0				# spontaneous curvature of membrane
kcMembraneBending = 83.4		# membrane bending constant (pN.nm)
usMembraneStretching = 250.0	# membrane streching modulus (pN/nm)
uvVolumeConstraint = 0.0		# volume constraint coefficient (pN/nm^2)
isGlobalConstraint = true      # true to enable global mode for area and volume

# Which implementation evaluates the per-face energies and forces.
#   cpu  - the default; the CPU loops
#   gpu  - the CUDA backend; fails the run if no device is usable, so that a
#          job submitted as a GPU run cannot silently report CPU timings
#   auto - the GPU when one is usable, the CPU otherwise, saying which
# All three compute the same thing. Requires -DSLIMED_ENABLE_CUDA=ON to build.
# See docs/gpu_acceleration.md, including where the GPU actually wins.
forceBackend = cpu
KBT = 4.17                      # 1KbT = 4.17 pN.nm
thermalFluctuationEnabled = false         # true to enable Metropolis thermal trial moves
thermalFluctuationInterval = 50           # iteration interval between thermal trial moves
thermalFluctuationTemperatureKelvin = 298.0       # thermodynamic temperature in K (298 K ~ room temperature)
thermalFluctuationMinTemperatureKelvin = 298.0    # lower bound for annealed temperature in K
thermalFluctuationCoolingRate = 1.0       # multiplicative cooling rate after each thermal trial
thermalFluctuationStepScale = 0.02        # proposal displacement std. dev. as a fraction of lFace
setRelaxAreaToDefault = false   # true to set relax area equal to the area of starting configuration
relaxArea = 76500.0             # use this value as relax area if the option above is set to false

# dynamics model parameters
timeStep = 0.001                  # in us
diffConst = 1.0                # diffusion constant, nm^2/us

# How often the dynamics writes a trajectory frame to meshpoint*.csv and
# surfacepoint*.csv.  1 = every iteration, which is the old behaviour and is
# only affordable for short runs: one line per step per vertex reaches tens of
# gigabytes at the iteration counts an equilibrium measurement needs.
meshpointOutputInterval = 1

# The Brownian step displaces the Loop limit surface S = M C and then maps back
# to the control net with C = M^-1 S.  The force the mesh reports is -dE/dC, so
# driving S with it directly makes the mobility and the noise inconsistent and
# the sampled distribution is not exp(-E/kT): every mode comes out too warm by
# 1/m(q), the reciprocal of the limit mask's Fourier symbol (1 at long
# wavelength, ~4 at the zone corner).  true maps the force onto the
# limit-surface coordinates first, which restores fluctuation-dissipation.
# Set false only to reproduce results from before this was fixed.
fdtConsistentSurfaceUpdate = true

# Under a periodic boundary the fourth ring in from each edge duplicates the
# ring on the far side; postprocess_ghost_periodic() overwrites it from its
# partner every step, so it is not an independent coordinate.  It used to be
# given its own random kick first, and surface2mesh spread that kick over the
# whole mesh before it was overwritten -- extra heat with no extra friction.
# Set true only to reproduce results from before this was fixed.
integratePeriodicDuplicates = false

############################################
## Insertion Mode
############################################

isInsertionIncluded = false		# true to enable insertions
sigma = 0.0						# 2*sigma is the length scale of decaying spontaneous curvature, 
								# expansion of nonzero curvature due to insertion (nm)

############################################
## Scaffolding Mode
############################################

# File paths below are resolved relative to the working directory the
# executable is launched from (the repository root for the shipped defaults).
# Each file is only opened when its corresponding flag above it is true.

isEnergyHarmonicBondIncluded = true    # true to enable harmonic bond energy for scaffolding
scaffoldingFileName = data/csv/GagR50_392.csv     # scaffolding point cloud, one "x,y,z" per line

isGagScaffoldingEnergyIncluded = false # true to enable the Gag scaffolding energy term
gagReferenceStateFileName =            # NERDSS-extracted .dat reference geometry (required if the flag above is true)
gagReactionFileName =                  # NERDSS .inp reaction file defining Gag interfaces (required if the flag above is true)

isIdealizedProteinLatticeEnergyIncluded = false  # true to enable the idealized protein lattice energy term
idealizedProteinLatticeFileName =                # idealized lattice .json/.dat state (required if the flag above is true)

gagKsigma = 1000.0
gagKtheta = 1000.0
gagKphi = 1000.0
gagKomega = 1000.0
gagFiniteDifferenceStep = 5e-4
gagPropagationStepSize = 5e-5
gagPreRelaxSteps = 0

relaxLengthRatioApproximation = 1.0  # ratio of relax length to cap length approximation
scaffoldingZeroPlaneZ = 45.0         # height of the flat membrane plane around the Gag cap
propagateScaffoldingInterv = 50       # Iteration interval for repositioning scaffolding based on energy and force
propagateScaffoldingNstep = 10      # Number of steps every time propagating scaffolding

############################################
## Developer options
############################################

VERBOSE_MODE = false          # true to enable verbose commandline output
